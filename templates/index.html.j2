<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Resume - Alpana Chaphalkar</title>
    <link rel="stylesheet" href="style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
</head>
<body>
    <div class="resume-container">
        <header>
            <div class="header-content">
                <h1>Alpana Chaphalkar</h1>
                <!-- <p class="subtitle">DevOps Engineer</p> -->
                <div class="contact-info">
                    <a href="mailto:alpanachaphalkar@gmail.com" title="Email Me">
                        <i class="fa-solid fa-envelope"></i>
                    </a>
                    <a href="https://www.linkedin.com/in/alpana-chaphalkar-0506b741/" target="_blank" title="LinkedIn">
                        <i class="fa-brands fa-linkedin"></i>
                    </a>
                    <a href="https://github.com/xplorinrolypoly" target="_blank" title="GitHub Profile">
                        <i class="fa-brands fa-github"></i>
                    </a>
                    <a href="https://www.youtube.com/@xplorinrolypoly" target="_blank" title="YouTube Channel">
                        <i class="fa-brands fa-youtube"></i>
                    </a>
                    <a href="https://www.google.com/maps/search/Munich,+Germany" target="_blank" title="Munich, Germany 🇩🇪">
                        <i class="fa-solid fa-location-dot"></i>
                    </a>
                    <a href="alpana-chaphalkar-resume.pdf" class="download-icon" download title="Download PDF">
                        <i class="fa-solid fa-file-pdf"></i>
                    </a>
                    <a href="https://xplorinrolypoly.github.io/resume/" class="website-icon" target="_blank" title="Website">
                        <i class="fa-solid fa-globe"></i>
                    </a>
                </div>
            </div>
        </header>

        <section class="experience-section">
            <h2>Professional Experience</h2>
            {% for job in experience %}
            <article class="job-entry">
                <div class="job-header-inline">
                    <h3>{{ job.title }}</h3>
                    <span class="separator">@</span>
                    <a href="{{ job.companyUrl }}" target="_blank" class="company-link">{{ job.company }}</a>
                    <span class="date-inline">({{ job.period }})</span>
                </div>
                <ul>
                    {% for bullet in job.bullets %}
                    <li>{{ bullet }}</li>
                    {% endfor %}
                </ul>
            </article>
            {% endfor %}
        </section>

        <section class="education-section">
            <h2>Education</h2>
            <ul class="education-list">
                {% for edu in education %}
                <li>
                    <div class="education-degree">
                        <h3>{{ edu.degree }}</h3>
                        <span class="date-inline">({{ edu.period }})</span>
                    </div>
                    <div class="education-institution">
                        <a href="{{ edu.institutionUrl }}" target="_blank" class="institution-link">{{ edu.institution }}</a>
                    </div>
                </li>
                {% endfor %}
            </ul>
        </section>

        <section class="certifications-section">
            <h2>Certifications</h2>
            <ul class="certifications-list">
                {% for cert in certificates %}
                <li><a href="{{ cert.url }}" target="_blank">{{ cert.name }}</a></li>
                {% endfor %}
            </ul>
        </section>
        
        <section class="languages-section">
            <h2>Languages</h2>
            <ul class="languages-list">
                {% for lang in languages %}
                <li><strong>{{ lang.language }}</strong> ({{ lang.proficiency }})</li>
                {% endfor %}
            </ul>
        </section>
    </div>
</body>
</html>